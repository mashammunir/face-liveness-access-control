# Environments
.venv/
venv/
env/
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Data (large / private — do not commit raw face data)
data/train/*
data/val/*
data/test/*
!data/train/live/.gitkeep
!data/train/spoof/.gitkeep
!data/val/live/.gitkeep
!data/val/spoof/.gitkeep
!data/test/live/.gitkeep
!data/test/spoof/.gitkeep

# Models & databases (regenerate locally, don't commit binaries)
models/*.pth
models/*.db
models/*.db-journal

# Results (regenerated by evaluate_liveness.py)
results/*.png
results/*.json

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Jupyter
.ipynb_checkpoints/
