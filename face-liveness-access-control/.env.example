# Copy this file to .env and adjust values as needed.
# .env is git-ignored — never commit real secrets or machine-specific paths.

# Path to the trained liveness model weights
MODEL_PATH=models/liveness_model.pth

# Path to the SQLite database storing registered users
DATABASE_PATH=models/users.db

# Path to the SQLite database storing access logs
ACCESS_LOG_PATH=models/access_log.db

# Dataset directory (train/val/test split)
DATA_DIR=data

# Directory where evaluation results (confusion matrix, metrics.json) are saved
RESULTS_DIR=results

# Webcam device index (0 is usually the default built-in camera)
CAMERA_INDEX=0

# Minimum face size (pixels) to accept a detection as valid
MIN_FACE_SIZE=80

# Liveness decision threshold: probability >= this value => LIVE
LIVENESS_THRESHOLD=0.5

# Input crop size (pixels, square) fed into the liveness CNN
LIVENESS_INPUT_SIZE=128

# Face recognition cosine-similarity threshold: score >= this => match
FACE_RECOGNITION_THRESHOLD=0.6

# Training hyperparameters
TRAIN_BATCH_SIZE=32
TRAIN_LEARNING_RATE=1e-4
TRAIN_EPOCHS=15
EARLY_STOPPING_PATIENCE=5
